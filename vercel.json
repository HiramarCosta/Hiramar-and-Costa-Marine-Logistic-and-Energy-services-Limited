{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.hiramarandcosta.com" }],
      "destination": "https://hiramarandcosta.com/$1",
      "permanent": true
    }
  ],

  "rewrites": [
    { "source": "/manager",   "destination": "/admin.html" },
    { "source": "/about-us",  "destination": "/about-us.html" },
    { "source": "/services",  "destination": "/services.html" },
    { "source": "/equipment", "destination": "/equipment.html" },
    { "source": "/contact",   "destination": "/contact.html" }
  ],

  "headers": [
    {
      "source": "/(admin.html|manager)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
